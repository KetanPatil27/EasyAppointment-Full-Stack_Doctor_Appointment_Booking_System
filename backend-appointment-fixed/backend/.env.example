# EasyAppointment Backend - Environment Variables Template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Server ---
PORT=2029
HOSTNAME=localhost
NODE_ENV=development

# --- Database ---
# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/easyappointment
# MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/easyappointment?retryWrites=true&w=majority

# --- Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be at least 32 characters. Rotate quarterly in production.
JWT_SECRET=replace_with_64_char_hex_secret

# --- Email ---
# Two delivery options. The mailer prefers Resend if RESEND_API_KEY is set,
# otherwise falls back to Nodemailer + Gmail. If neither is set, emails are
# logged to the server console (good for local development).
#
# Option A — Resend (REQUIRED on Render free tier; outbound SMTP is blocked there)
# Sign up at https://resend.com (free 3,000 emails/month). Copy your API key.
# Until you verify a domain, you can only send to your Resend account email.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=EasyAppointment <onboarding@resend.dev>
#
# Option B — Nodemailer with Gmail (works locally, NOT on Render free tier)
# https://myaccount.google.com/apppasswords — 16 chars, NO spaces
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_16_char_google_app_password

# --- CORS ---
# Comma-separated OR JSON array of allowed frontend origins.
# In production, point at your real deployed frontend URL(s).
# Examples (pick ONE form):
#   ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
#   ALLOWED_ORIGINS=["https://easyappointment.com","https://www.easyappointment.com"]
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Frontend URL ---
# Used in transactional email links (password reset, appointment confirmation).
# Must NOT have a trailing slash. Set to your real deployed frontend in production.
FRONTEND_URL=http://localhost:3000

# --- Password reset behavior ---
# true  = return "No account found" if the email isn't registered (better UX)
# false = always return generic success message (prevents email enumeration)
# Per-email rate limit (3/hour) applies in BOTH modes.
STRICT_EMAIL_VALIDATION=false

# --- Email OTP verification (Upgrade 4) ---
# Time before an OTP becomes invalid. Default 10.
OTP_EXPIRY_MINUTES=10
# How many wrong attempts before the OTP is invalidated entirely. Default 5.
OTP_MAX_ATTEMPTS=5
# Minimum seconds between resend requests for the same email. Default 60.
OTP_RESEND_COOLDOWN_SECONDS=60
