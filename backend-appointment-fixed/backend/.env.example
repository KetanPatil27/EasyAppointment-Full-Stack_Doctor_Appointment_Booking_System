# EasyAppointment Backend - Environment Variables Template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Server ---
PORT=2029
HOSTNAME=localhost
NODE_ENV=development

# --- Database ---
# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/easyappointment
# MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/easyappointment?retryWrites=true&w=majority

# --- Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be at least 32 characters. Rotate quarterly in production.
JWT_SECRET=replace_with_64_char_hex_secret

# --- Email (Nodemailer / Gmail App Password) ---
# https://myaccount.google.com/apppasswords
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_16_char_google_app_password

# --- CORS ---
# Comma-separated OR JSON array of allowed frontend origins.
# In production, point at your real deployed frontend URL(s).
# Examples (pick ONE form):
#   ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
#   ALLOWED_ORIGINS=["https://easyappointment.com","https://www.easyappointment.com"]
ALLOWED_ORIGINS=["http://localhost:3000"]
