{
  "name": "easyappointment",
  "description": "Backend for EasyAppointment appointment project",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">= 18.0.0"
  },
  "scripts": {
    "dev": "nodemon -x ts-node src/index.ts",
    "compile": "shx rm -rf lib/ && tsc",
